_active_model = None  # populate via set_world_model() once the real LSTM checkpoint exists


class _CallableModelAdapter:
    """Wraps a bare predict_one_step(sequence) -> next_state FUNCTION so it
    satisfies the .predict(window) -> next_state contract predict_rollout_windowed
    expects. This matters because Section 2's deliverable is literally worded as
    'a documented predict_one_step(sequence) -> next_state function' - that could
    be a plain function just as easily as a class method, and set_world_model()
    needs to work either way without you having to remember to wrap it yourself."""

    def __init__(self, fn):
        self._fn = fn

    def predict(self, window: np.ndarray) -> np.ndarray:
        return self._fn(window)


def set_world_model(model) -> None:
    """Register the real (or mock) World Model once, so callers of
    forecast() never need to know a model object exists at all - this
    is what keeps Utkarsh's and Sirjan's code from having to change when
    you swap MockWindowedWorldModel for the real LSTM checkpoint.

    Accepts EITHER form your teammate might hand you:
      - a bare function: predict_one_step(sequence) -> next_state
      - an object exposing .predict(window) -> next_state
      - an object exposing .predict_one_step(window) -> next_state
    and normalizes all three to the internal .predict(window) contract,
    matching the real predict_one_step(sequence) -> next_state signature
    from Section 2 of the build guide (windowed input, not single-state -
    that's the SPEC default; predict_rollout/MockWorldModel above is kept
    only for standalone single-state testing).
    """
    global _active_model
    if hasattr(model, "predict"):
        pass  # already satisfies the contract
    elif hasattr(model, "predict_one_step"):
        model = _CallableModelAdapter(model.predict_one_step)
    elif callable(model):
        model = _CallableModelAdapter(model)
    else:
        raise TypeError(
            "set_world_model() needs a callable, an object with .predict(), "
            "or an object with .predict_one_step() - got " + type(model).__name__
        )
    _active_model = model


def forecast(current_window_sequence: np.ndarray, steps: int = 4,
             deviation_scorer: Optional["BaselineDeviationScorer"] = None):
    """
    THE integration-contract function (Section 9 of the build guide).
    Exact name and shape Utkarsh's stage mapper and Sirjan's dashboard
    will call directly.

    Args:
        current_window_sequence: shape (T, N_FEATURES) - the last T
            observed windows. NOT a single state - matches
            predict_one_step(sequence)'s expected input.
        steps: K, number of future windows to forecast. Guide recommends
            starting at K=4 (default here); our horizon-stability
            experiment (horizon_experiment.py) found K=7 is the largest
            horizon that stays stable if you want to push further.
        deviation_scorer: optional BaselineDeviationScorer for the
            probability estimate. Defaults to fit_default() if not
            supplied. Deliberately NOT rule-based (map_stage_and_probability)
            here, so this module's probability doesn't quietly depend on
            Utkarsh's not-yet-finalised stage thresholds.

    Returns:
        [(probability, predicted_state), ...] for step 1..K (t+1..t+K).
        predicted_state is the raw (N_FEATURES,) np.ndarray - exactly
        what Utkarsh's map_to_stage(predicted_state) expects as input.
    """
    current_window_sequence = np.asarray(current_window_sequence, dtype=float)
    model = _active_model or MockWindowedWorldModel(window_size=current_window_sequence.shape[0])
    scorer = deviation_scorer or BaselineDeviationScorer().fit_default()

    trajectory = predict_rollout_windowed(model, current_window_sequence, steps)

    results = []
    for state_vec in trajectory:
        prob = scorer.score(state_vec)
        results.append((round(float(prob), 4), state_vec))
    return results


